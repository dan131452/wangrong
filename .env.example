# 生图 API 配置模板
#
# 用法：把本文件复制成 .env，填入自己的 key 即可。
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env
#
# .env 已被 .gitignore 忽略，不会上传到仓库；请勿把真实 key 写进本文件。

# ── 必填 ──────────────────────────────────────────────
# 生图服务的 API Key。留空时 gen / serve 会直接报错并提示。
IMAGE_API_KEY=

# ── 选填（不填则用下面的默认值）──────────────────────
# API 根地址：任何 OpenAI 兼容的 /v1 端点都可以
IMAGE_API_BASE=https://api.ipc.wiki/v1

# 模型名
IMAGE_MODEL=gpt-image-2.5

# 出图尺寸：gpt-image 系列合法横版尺寸，管道会自动居中裁剪
IMAGE_SIZE=1536x1024
